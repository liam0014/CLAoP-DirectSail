	{
		if (sti(pchar.Ship.POS.Mode) != SHIP_WAR)
		{
			if (iCharacterIndex == GetMainCharacterIndex() || IsCompanion(rCharacter))
			{
				fShipSpeed = fShipSpeed * 1.01;
			}
		}
	}

