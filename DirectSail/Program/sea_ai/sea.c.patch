#find
	wdmUpdateAllEncounterLivetime(); // homo карта 25/03/07
	Flag_Rerise(); // переподнять флаг при выходе на карту, прменить отношения нации в столбец ГГ
#replacewith
	// Direct Sail maintains quest lifetimes without stripping quest.event.
	// Expired encounters are handed to vanilla wdmEncounterDelete(), so the
	// original Map_TraderSucces / Map_WarriorEnd event is preserved.
	DirectSail_QuestUpdateLifetimeClock();
	// Direct Sail quest shadows are a tactical-sea representation only.
	// Return surviving shadows to the normal quest queue before the native
	// world map is created.
	DirectSail_QuestPrepareWorldMapHandoff();
	Flag_Rerise(); // переподнять флаг при выходе на карту, прменить отношения нации в столбец ГГ
#endreplace

#find
	UnloadLocation(loc);
	EmptyAllFantomShips();
	wdmEmptyAllDeadQuestEncounter(); // трем случайки
}
#replacewith
	UnloadLocation(loc);
	EmptyAllFantomShips();
	wdmEmptyAllDeadQuestEncounter(); // трем случайки

	// Time spent ashore also counts against live quest encounter timeouts.
	// Age them before returning any Direct Sail shadows to the native map.
	DirectSail_QuestUpdateLifetimeClock();
	DirectSail_QuestPrepareWorldMapHandoff();
}
#endreplace

#find
	// Quest check
	Event(EVENT_SEA_LOGIN, "");
	if (bSkipSeaLogin) return;
#replacewith
	// Quest check
	//
	// Direct Sail sea-zone transitions call SeaLogin() after the old tactical
	// sea has been unloaded but before worldMap.island is updated to the new
	// zone.  At this exact point pchar.location already contains the destination
	// island/sea-region, so pchar.location != worldMap.island identifies the
	// strategic-travel boundary without creating a real world-map entity.
	//
	// Prototype 1 deliberately enables this bridge only when one of the two
	// validation quests is actually pending: Hugo Lumbersaw's return stage or
	// the overdue passenger deck scene.  Other MapEnter hooks remain untouched.
	if(!IsEntity(&worldMap))
	{
		if(sIslandID != "")
		{
			if(CheckAttribute(&worldMap, "island"))
			{
				if(worldMap.island != sIslandID)
				{
					if(CheckAttribute(pchar, "quest.PDM_Lesopilka_Treasures_BackToVillemstad") ||
					   CheckAttribute(pchar, "quest.ConvoyMapPassenger"))
					{
						if(CheckAttribute(&worldMap, "islands." + sIslandID + ".position.x") &&
						   CheckAttribute(&worldMap, "islands." + sIslandID + ".position.z"))
						{
							pchar.DirectSail.MapEnterFrom = worldMap.island;
							pchar.DirectSail.MapEnterTo = sIslandID;

							// Rebuild the destination strategic-map coordinate context from
							// the SeaLogin data.  WdmPrepareMapForAbordage() expects both
							// worldMap.zeroX/Z and the temporary worldMap.island.x/z pair.
							worldMap.zeroX = worldMap.islands.(sIslandID).position.x;
							worldMap.zeroZ = worldMap.islands.(sIslandID).position.z;
							worldMap.playerShipX = stf(worldMap.zeroX) + stf(Login.PlayerGroup.x) / makefloat(DirectSail_GetIslandScale(sIslandID));
							worldMap.playerShipZ = stf(worldMap.zeroZ) + stf(Login.PlayerGroup.z) / makefloat(DirectSail_GetIslandScale(sIslandID));
							worldMap.playerShipAY = Login.PlayerGroup.ay;
							worldMap.island = sIslandID;
							worldMap.island.x = worldMap.zeroX;
							worldMap.island.z = worldMap.zeroZ;

							pchar.DirectSail.MapEnterPulse = true;
							trace("DS MAPENTER PULSE: from=" + pchar.DirectSail.MapEnterFrom +
							      " to=" + sIslandID +
							      " pos=" + worldMap.playerShipX + "," + worldMap.playerShipZ);
						}
						else
						{
							trace("DS MAPENTER ERROR: destination strategic coordinates missing for " + sIslandID);
						}
					}
				}
			}
		}
	}

	Event(EVENT_SEA_LOGIN, "");

	if(CheckAttribute(pchar, "DirectSail.MapEnterPulse"))
	{
		DeleteAttribute(pchar, "DirectSail.MapEnterPulse");
		DeleteAttribute(pchar, "DirectSail.MapEnterCurrentQuest");

		if(CheckAttribute(pchar, "DirectSail.MapEnterInterrupted"))
		{
			trace("DS MAPENTER INTERRUPT HANDOFF: location=" + pchar.tmpWDMtoLand.location);
			PostEvent("DirectSail_MapEnterInterruptFinish", 1);
		}
		else
		{
			trace("DS MAPENTER CONTINUE: destination=" + sIslandID);
			DeleteAttribute(pchar, "DirectSail.MapEnterFrom");
			DeleteAttribute(pchar, "DirectSail.MapEnterTo");
		}
	}

	if (bSkipSeaLogin) return;
#endreplace
