#find
void SaveGame()
{
	string saveName = GetEventData();
	string saveData = GetEventData();
	DelEventHandler("evntSave","SaveGame");

	aref arTmp;
	if( !GetEntity(arTmp,"fader") )
	{
		//implemet interface
		//LaunchQuickSaveMenu();
		pchar.version_number = 104;
		SaveEngineState(saveName);
		ISetSaveData(saveName,saveData);
	}

	//hide interface
	PostEvent("DoInfoShower",1,"sl","save game",false);
	DeleteEntitiesByType("scrshoter");
	HideQuickSaveMenu();
	SaveLastSavePathToCurrentProfile(saveName);
	SaveLastProfileToCurrentProfile();
}
#replacewith
void SaveGame()
{
	string saveName = GetEventData();
	string saveData = GetEventData();
	DelEventHandler("evntSave","SaveGame");

	// Never commit a save while CLAoP has no valid world context.  OnSave()
	// itself treats this state as an error, and a save written here cannot be
	// restored because there is no world map, tactical sea or loaded location
	// to record.  Direct Sail can briefly create exactly this state while a
	// synthetic MapEnter deck interruption returns to tactical sea.
	if(!IsEntity(&worldMap) && !IsEntity(&AISea) && FindLoadedLocation() < 0)
	{
		if(CheckAttribute(pchar, "DirectSail.MapEnterInterruptReturn"))
		{
			trace("DS MAPENTER SAVE BLOCK: invalid transition context");
			DeleteAttribute(pchar, "DirectSail.MapEnterInterruptReturn");
		}
		else
		{
			trace("DS SAVE BLOCK: no valid world context");
		}

		// A transition autosave may have registered an after-save continuation.
		// Since no engine save is being started, run that continuation ourselves
		// so the pending return to sea is not left waiting for Event_AfterSave.
		bAutoSaveStarted = false;
		PostEvent("Event_AfterSave", 0);
		PostEvent("DoInfoShower",1,"sl","save game",false);
		DeleteEntitiesByType("scrshoter");
		HideQuickSaveMenu();
		return;
	}

	aref arTmp;
	if( !GetEntity(arTmp,"fader") )
	{
		//implemet interface
		//LaunchQuickSaveMenu();
		pchar.version_number = 104;
		SaveEngineState(saveName);
		ISetSaveData(saveName,saveData);
	}

	//hide interface
	PostEvent("DoInfoShower",1,"sl","save game",false);
	DeleteEntitiesByType("scrshoter");
	HideQuickSaveMenu();
	SaveLastSavePathToCurrentProfile(saveName);
	SaveLastProfileToCurrentProfile();
}
#endreplace

#find
void LoadGame_continue()
{
	DelEventHandler("frame","LoadGame_continue");
	FreezeGroupControls(curKeyGroupName,true);
	LoadEngineState(pchar.savegamename);
}
#replacewith
void LoadGame_continue()
{
	DelEventHandler("frame","LoadGame_continue");
	FreezeGroupControls(curKeyGroupName,true);
	DirectSail_WatchmanPrepareLoad();
	LoadEngineState(pchar.savegamename);
	DirectSail_WatchmanFinishLoad();
}
#endreplace
