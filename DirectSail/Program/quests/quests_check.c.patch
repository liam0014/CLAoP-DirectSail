#replacewith
		case "MapEnter":
			if(IsEntity(&worldMap)) return true;

			// Direct Sail emits a one-shot synthetic MapEnter pulse only at a
			// genuine sea-zone transition. Most vanilla MapEnter conditions use
			// the event as a strategic-travel / leave-sea sequencing hook and do
			// not actually require a live world-map entity, so allow those by
			// default. Keep a small explicit denylist for callbacks whose audited
			// implementations genuinely require the native world map or are part
			// of the Peter Blood world-map tutorial itself.
			if(CheckAttribute(pchar, "DirectSail.MapEnterPulse"))
			{
				if(CheckAttribute(pchar, "DirectSail.MapEnterCurrentQuest"))
				{
					sTmpString = pchar.DirectSail.MapEnterCurrentQuest;

					// Once a deck/location interruption has been requested, do not let
					// another MapEnter condition consume itself in the same check pass.
					if(CheckAttribute(pchar, "DirectSail.MapEnterInterrupted"))
					{
						trace("DS MAPENTER SKIP AFTER INTERRUPT: quest=" + sTmpString);
						return false;
					}

					// Known native-world-map dependencies. These callbacks either test
					// IsEntity(&worldMap) themselves before doing their real work or
					// intentionally teach/use the actual Peter Blood world map.
					if(sTmpString == "time_over_Beliz_attack_Map_01" ||
					   sTmpString == "time_over_Beliz_attack_Map_02" ||
					   sTmpString == "PQ8_PanamaTimerOver_01" ||
					   sTmpString == "PQ8_PanamaTimerOver_02" ||
					   sTmpString == "SeaPearl_FirstTime_Late_01" ||
					   sTmpString == "PGGQuest1_Time2Late_01" ||
					   sTmpString == "BloodLine_GlobalTutor_WorldmapTutorial" ||
					   sTmpString == "BloodLine_GlobalTutor_OnExitToMapAgain")
					{
						trace("DS MAPENTER DENYLIST: quest=" + sTmpString);
						return false;
					}

					trace("DS MAPENTER FIRE: quest=" + sTmpString);
					return true;
				}
			}

    		return false;
    	break;
#endreplace

