#find
bool DoReloadFromWorldMapToLocation(string idLocation, string idGroup, string idLocator)
{
	// новые фичи к3 -->
	worldMap.old = "";
	aref arOldMapPos;
	makearef(arOldMapPos, worldMap.old);

	WdmPrepareMapForAbordage(arOldMapPos);
	// новые фичи к3 <--

	if(FindLocation(idLocation)==-1) return false;
	pchar.tmpWDMtoLand.location = idLocation;
	pchar.tmpWDMtoLand.group = idGroup;
	pchar.tmpWDMtoLand.locator = idLocator;
	QuitFromWorldMap();
	return true;
}
#replacewith
bool DoReloadFromWorldMapToLocation(string idLocation, string idGroup, string idLocator)
{
	// новые фичи к3 -->
	worldMap.old = "";
	aref arOldMapPos;
	makearef(arOldMapPos, worldMap.old);

	WdmPrepareMapForAbordage(arOldMapPos);
	// новые фичи к3 <--

	if(FindLocation(idLocation)==-1) return false;
	pchar.tmpWDMtoLand.location = idLocation;
	pchar.tmpWDMtoLand.group = idGroup;
	pchar.tmpWDMtoLand.locator = idLocator;

	// During a Direct Sail strategic-transition pulse the old tactical sea has
	// already been unloaded, but there is intentionally no real world-map
	// entity to quit. Preserve the vanilla reload request and let SeaLogin()
	// abort before creating the destination tactical sea.
	if(CheckAttribute(pchar, "DirectSail.MapEnterPulse"))
	{
		pchar.DirectSail.MapEnterInterrupted = true;
		bSkipSeaLogin = true;
		trace("DS MAPENTER INTERRUPT REQUEST: location=" + idLocation +
		      " group=" + idGroup +
		      " locator=" + idLocator);
		return true;
	}

	QuitFromWorldMap();
	return true;
}
#endreplace

