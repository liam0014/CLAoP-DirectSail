#replacewith
bool MakeAutoSave()
{
	if(CheckAttribute(pchar, "DirectSail.MapEnterInterruptReturn"))
		trace("DS SAVE DIAG: MakeAutoSave marker=1 locIndex=" + FindLoadedLocation() + " pchar.location=" + pchar.location);
	else
		trace("DS SAVE DIAG: MakeAutoSave marker=0 locIndex=" + FindLoadedLocation() + " pchar.location=" + pchar.location);

	// Some older map-triggered deck scenes use the legacy autosave API.
	// Preserve this narrow fallback for Direct Sail synthetic deck returns.
	if(CheckAttribute(pchar, "DirectSail.MapEnterInterruptReturn"))
	{
		trace("DS MAPENTER AUTOSAVE SKIP: legacy MakeAutoSave");
		DeleteAttribute(pchar, "DirectSail.MapEnterInterruptReturn");
		return false;
	}

	if( InterfaceStates.Launched != 0 ) {return false;}

	DeleteAfterSaveFunction();
#endreplace
