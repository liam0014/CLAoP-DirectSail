// Direct Sail paper-map position marker.
//
// map_bad and map_normal use the same chart calibration. Map_Best uses the
// same world coordinates but a different chart layout, so it has its own
// transform. Separate CreateString entries are used for the two layouts so
// switching maps inside the atlas never requires moving an existing string.
void UpdatePlayerPaperMapMarker(string sMapID)
{
	float fScale;
	float fWorldX;
	float fWorldZ;
	float fImageX;
	float fImageY;
	float fScreenX;
	float fScreenY;
	string sIsland;
	float fWorldX2;
	float fWorldZ2;
	float fWorldXZ;

	// Hide any marker left from another Caribbean-wide map in this atlas session.
	if(CheckAttribute(&GameInterface, "strings.PaperMapMarkerNormal"))
	{
		GameInterface.strings.PaperMapMarkerNormal = "";
	}
	if(CheckAttribute(&GameInterface, "strings.PaperMapMarkerBest"))
	{
		GameInterface.strings.PaperMapMarkerBest = "";
	}

	// These are the three Caribbean-wide paper maps.
	if(sMapID != "map_bad" && sMapID != "map_normal" && sMapID != "Map_Best")
	{
		return;
	}

	// Only show a live position while the player is physically at sea.
	if(!bSeaActive)
	{
		return;
	}

	if(!CheckAttribute(pchar, "Ship.Pos.x") || !CheckAttribute(pchar, "Ship.Pos.z"))
	{
		return;
	}

	if(!CheckAttribute(&worldMap, "zeroX") || !CheckAttribute(&worldMap, "zeroZ"))
	{
		return;
	}

	sIsland = "";
	if(CheckAttribute(&worldMap, "island")) sIsland = worldMap.island;

	// Match CLAOP's native sea-to-world conversion. Cuba and the mainland
	// coast sea maps use scale 25; the other sea maps use scale 50.
	fScale = 50.0;
	if(sIsland == "Cuba1" || sIsland == "Cuba2" || sIsland == "Beliz" || sIsland == "SantaCatalina"
		|| sIsland == "PortoBello" || sIsland == "Cartahena" || sIsland == "Maracaibo"
		|| sIsland == "Caracas" || sIsland == "Cumana")
	{
		fScale = 25.0;
	}

	// Current local sea coordinates -> persistent world-map coordinates.
	fWorldX = (stf(pchar.Ship.Pos.x) / fScale) + stf(worldMap.zeroX);
	fWorldZ = (stf(pchar.Ship.Pos.z) / fScale) + stf(worldMap.zeroZ);

	if(sMapID == "Map_Best")
	{
		// map_good.tga uses a wider geographic layout than map_1/map_2.
		fImageX = 523.576 + (fWorldX * 0.4485043);
		fImageY = 513.614 - (fWorldZ * 0.4349451);
	}
	else
	{
		// map_2.tga: calibrated against its printed port positions.
		//
		// The paper chart is not a perfectly linear projection of the
		// world-map coordinate system, so use a small quadratic transform.
		fWorldX2 = fWorldX * fWorldX;
		fWorldZ2 = fWorldZ * fWorldZ;
		fWorldXZ = fWorldX * fWorldZ;

		fImageX = 512.1996 + (0.3581936 * fWorldX) + (0.0040861 * fWorldZ) + (0.0000042663 * fWorldX2) - (0.0000129460 * fWorldXZ) - (0.0000131876 * fWorldZ2);

		fImageY = 503.1205 + (0.0046319 * fWorldX) - (0.4660933 * fWorldZ) + (0.0000031203 * fWorldX2) - (0.0000049649 * fWorldXZ) + (0.0000003682 * fWorldZ2);
	}

	// Outside the paper-map texture: do not draw.
	if(fImageX < 0.0 || fImageX > 1024.0 || fImageY < 0.0 || fImageY > 1024.0)
	{
		return;
	}

	// 1024x1024 source texture -> MAPS_PICTURE rectangle 7,60,607,570.
	fScreenX = 7.0 + (fImageX * 600.0 / 1024.0);
	fScreenY = 60.0 + (fImageY * 510.0 / 1024.0);

	if(sMapID == "Map_Best")
	{
		if(!CheckAttribute(&GameInterface, "strings.PaperMapMarkerBest"))
		{
			// CreateString is horizontally centred; lift the glyph slightly so the
			// visual centre of the + sits on the calculated map position.
			CreateString(true, "PaperMapMarkerBest", "+", FONT_NORMAL, COLOR_RED,
					 makeint(fScreenX), makeint(fScreenY) - 5, SCRIPT_ALIGN_CENTER, 1.0);
		}
		else
		{
			GameInterface.strings.PaperMapMarkerBest = "+";
		}
	}
	else
	{
		if(!CheckAttribute(&GameInterface, "strings.PaperMapMarkerNormal"))
		{
			// CreateString is horizontally centred; lift the glyph slightly so the
			// visual centre of the + sits on the calculated map position.
			CreateString(true, "PaperMapMarkerNormal", "+", FONT_NORMAL, COLOR_RED,
					 makeint(fScreenX), makeint(fScreenY) - 5, SCRIPT_ALIGN_CENTER, 1.0);
		}
		else
		{
			GameInterface.strings.PaperMapMarkerNormal = "+";
		}
	}
}

