// Direct Sail persistent world-map encounter replenishment
// -----------------------------------------------------------------------------
#define DS_REPLENISH_LOCAL_TARGET           8
#define DS_REPLENISH_LOCAL_RADIUS           250.0
#define DS_REPLENISH_LOCAL_RADIUS_SQ        62500.0

// CLAOP 1.1.2 worldmap_encgen.c rates.
#define DS_REPLENISH_MERCHANT_RATE          0.09
#define DS_REPLENISH_WARRING_RATE           0.015
#define DS_REPLENISH_FOLLOW_RATE            0.025
#define DS_REPLENISH_SPECIAL_RATE           0.002

// Standard world-map clock: one game hour per world-map simulation second.
#define DS_REPLENISH_MAP_SECONDS_PER_HOUR   1.0

// Direct Sail spreads the normal daily repair formula across hourly ticks.
// 28 is a close approximation to vanilla daily repair across typical damage
// and Repair-skill ranges while avoiding a stronger-than-vanilla bias.
#define DS_HOURLY_REPAIR_DIVISOR            28.0


float GetDistance2DRel(float x1, float z1, float x2, float z2)
{
	float dx = x2 - x1;
	float dz = z2 - z1;

	return (dx * dx) + (dz * dz);
}

// The mainland sea maps cover long stretches of coast. Their single nominal
// world-map centre is therefore a poor measure of which sea zone owns a given
// Direct Sail position.
bool DirectSail_IsExtendedSeaRegion(string sIsland)
{
	if(sIsland == "Beliz" || sIsland == "SantaCatalina" || sIsland == "PortoBello"
		|| sIsland == "Cartahena" || sIsland == "Maracaibo"
		|| sIsland == "Caracas" || sIsland == "Cumana")
	{
		return true;
	}

	return false;
}

// Use both the island/region centre and every existing child anchor which
// exposes position.x and position.z (towns, shores, lighthouses, etc.). This
// prevents large islands such as Hispaniola from retaining the previous sea
// zone even when the player has already reached their coastline.
float DirectSail_GetSeaRegionDistanceSq(string sIsland, float fPlayerX, float fPlayerZ)
{
	float fBestDistance;
	float fDistance;
	float fAnchorX;
	float fAnchorZ;
	int i;
	int iNum;
	aref rRegion;
	aref rAnchor;
	string sRegionPath;

	fBestDistance = GetDistance2DRel(
		fPlayerX,
		fPlayerZ,
		stf(worldMap.islands.(sIsland).position.x),
		stf(worldMap.islands.(sIsland).position.z)
	);

	sRegionPath = "islands." + sIsland;
	makearef(rRegion, worldMap.(sRegionPath));
	iNum = GetAttributesNum(rRegion);

	for(i = 0; i < iNum; i++)
	{
		rAnchor = GetAttributeN(rRegion, i);

		if(!CheckAttribute(rAnchor, "position.x")) continue;
		if(!CheckAttribute(rAnchor, "position.z")) continue;

		fAnchorX = stf(rAnchor.position.x);
		fAnchorZ = stf(rAnchor.position.z);
		fDistance = GetDistance2DRel(fPlayerX, fPlayerZ, fAnchorX, fAnchorZ);

		if(fDistance < fBestDistance)
		{
			fBestDistance = fDistance;
		}
	}

	return fBestDistance;
}

