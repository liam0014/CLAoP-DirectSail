                            WdmCopyEncounterData(rGenerated1, sNewID1);

                            // Second free persistent ID.
                            iPersistentIndex = -1;
                            for(j = 0; j < 1000; j++)
                            {
                                sNewID2 = "enc_" + j;
                                sPath = "encounters." + sNewID2;

                                if(!CheckAttribute(&worldMap, sPath))
                                {
                                    iPersistentIndex = j;
                                    break;
                                }
                            }

                            if(iPersistentIndex >= 0)
                            {
                                sNewID2 = "enc_" + iPersistentIndex;

                                // ATTACKED
                                sPath = "encounters." + sNewID2;
                                worldMap.(sPath) = "";
                                makearef(rNew, worldMap.(sPath));
                                if(sSourceID != "")
                                {
                                    makearef(rShellSource, worldMap.encounters.(sSourceID));
                                    CopyAttributes(rNew, rShellSource);

                                    DeleteAttribute(rNew, "needDelete");
                                    DeleteAttribute(rNew, "dirSailEnc");
                                    DeleteAttribute(rNew, "quest");
                                    DeleteAttribute(rNew, "encdata");
                                    DeleteAttribute(rNew, "attacked");
                                }
                                else
                                {
                                    // Fallback: construct the native physical encounter shell
                                    // directly when no ordinary Merchant template exists.
                                    rNew.brnAlpha = 1;
                                    rNew.deleteAlpha = 1;

                                    rNew.y = 0.0;
                                    rNew.ax = frnd() * PIm2;
                                    rNew.ay = frnd() * PIm2;
                                    rNew.az = frnd() * PIm2;
                                    rNew.dltAx = 0.8;
                                    rNew.dltAz = 1.2;

                                    rNew.speed = 0.0;
                                    rNew.turnspd = 0.0;
                                    rNew.kMaxSpeed = 1.0;
                                    rNew.rspeed_x = 0.0;
                                    rNew.rspeed_y = 0.0;
                                    rNew.rspeed_z = 0.0;
                                    rNew.slope = 0.0;

                                    rNew.enc_id = 2147483647;
                                    rNew.isEnableKill = 1;
                                    rNew.isEnemy = 0;
                                    rNew.killme = 0;
                                    rNew.canSkip = 0;

                                    rNew.gotox = fX + 50.0 * sin(fAngle);
                                    rNew.gotoz = fZ + 50.0 * cos(fAngle);
                                    rNew.gotoRad = 2.0;
                                    rNew.isEnableSetDir = 0;
                                }

                                rNew.dsGenerated = true;
                                rNew.dsGeneratedKind = "Attacked";
                                rNew.type = "Attacked";
                                rNew.x = fX + fPairGap;
                                rNew.z = fZ + fPairGap;

                                if(CheckAttribute(rGenerated2, "worldMapShip"))
                                    rNew.modelName = rGenerated2.worldMapShip;

                                if(CheckAttribute(rGenerated2, "Nation"))
                                {
                                    iNation = sti(rGenerated2.Nation);

                                    if(GetNationRelation2MainCharacter(iNation) == RELATION_ENEMY)
                                        rNew.isEnemy = true;
                                    else
                                        rNew.isEnemy = false;
                                }

                                rNew.sec = MakeInt(GetSecond());
                                rNew.min = MakeInt(GetMinute());
                                rNew.hour = MakeInt(GetHour());
                                rNew.day = GetDataDay();
                                rNew.month = GetDataMonth();
                                rNew.year = GetDataYear();
                                rNew.livetime = fLifetime;

                                WdmCopyEncounterData(rGenerated2, sNewID2);

                                // Proven native pair relationship.
                                worldMap.encounters.(sNewID1).attacked = sNewID2;

                                trace("DS REPLENISH CREATED: Warring ids=" +
                                      sNewID1 + "," + sNewID2 +
                                      " shell=" + sShellMode +
                                      " nations=" + rGenerated1.Nation + "," + rGenerated2.Nation +
                                      " pos=" + fX + "," + fZ +
                                      " lifeDays=" + iTimeoutDays);

                                bCreated = true;
                            }
                            else
                            {
                                worldMap.encounters.(sNewID1).needDelete = "Direct Sail incomplete Warring pair";
                                trace("DS REPLENISH: Warring second ID unavailable; first entry marked for deletion.");
                            }
                        }
                    }
                }
                else
                {
                    trace("DS REPLENISH: Warring generation attempt failed.");
                }

                ReleaseMapEncounters();
            }
            else
            {
                iRollFollow = rand(1001) + 1;

                if(iRollFollow < wdmTimeOfLastFollow)
                {
                    wdmTimeOfLastFollow = 0.0;

                    if(!IsStopMapFollowEncounters())
                    {
                        iEncounter1 = -1;
                        iEncounter2 = -1;

                        if(GenerateMapEncounter(WDM_ETYPE_FOLLOW, worldMap.island, &iEncounter1, &iEncounter2))
                        {
                            rGenerated1 = GetMapEncounterRef(iEncounter1);

                            iPersistentIndex = -1;
                            for(j = 0; j < 1000; j++)
                            {
                                sNewID1 = "enc_" + j;
                                sPath = "encounters." + sNewID1;

                                if(!CheckAttribute(&worldMap, sPath))
                                {
                                    iPersistentIndex = j;
                                    break;
                                }
                            }

                            if(iPersistentIndex >= 0)
                            {
                                sNewID1 = "enc_" + iPersistentIndex;
                                sPath = "encounters." + sNewID1;

                                fAngle = frnd() * PIm2;
                                fSpawnRadius = fMinSpawnRadius + makefloat(rand(100));
                                fX = fPlayerMapX + fSpawnRadius * sin(fAngle);
                                fZ = fPlayerMapZ + fSpawnRadius * cos(fAngle);

                                sFollowShellType = "Merchant";
                                if(wdmIsEncounterEnemy(iEncounter1))
                                    sFollowShellType = "Follow";

                                worldMap.(sPath) = "";
                                makearef(rNew, worldMap.(sPath));
                                if(sSourceID != "")
                                {
                                    makearef(rShellSource, worldMap.encounters.(sSourceID));
                                    CopyAttributes(rNew, rShellSource);

                                    DeleteAttribute(rNew, "needDelete");
                                    DeleteAttribute(rNew, "dirSailEnc");
                                    DeleteAttribute(rNew, "quest");
                                    DeleteAttribute(rNew, "encdata");
                                    DeleteAttribute(rNew, "attacked");
                                }
                                else
                                {
                                    // Fallback: construct the native physical encounter shell
                                    // directly when no ordinary Merchant template exists.
                                    rNew.brnAlpha = 1;
                                    rNew.deleteAlpha = 1;

                                    rNew.y = 0.0;
                                    rNew.ax = frnd() * PIm2;
                                    rNew.ay = frnd() * PIm2;
                                    rNew.az = frnd() * PIm2;
                                    rNew.dltAx = 0.8;
                                    rNew.dltAz = 1.2;

                                    rNew.speed = 0.0;
                                    rNew.turnspd = 0.0;
                                    rNew.kMaxSpeed = 1.0;
                                    rNew.rspeed_x = 0.0;
                                    rNew.rspeed_y = 0.0;
                                    rNew.rspeed_z = 0.0;
                                    rNew.slope = 0.0;

                                    rNew.enc_id = 2147483647;
                                    rNew.isEnableKill = 1;
                                    rNew.isEnemy = 0;
                                    rNew.killme = 0;
                                    rNew.canSkip = 0;

                                    rNew.gotox = fX + 50.0 * sin(fAngle);
                                    rNew.gotoz = fZ + 50.0 * cos(fAngle);
                                    rNew.gotoRad = 2.0;
                                    rNew.isEnableSetDir = 0;
                                }

                                rNew.dsGenerated = true;
                                rNew.dsGeneratedKind = "Follow";
                                rNew.type = sFollowShellType;
                                rNew.x = fX;
                                rNew.z = fZ;

                                if(CheckAttribute(rGenerated1, "worldMapShip"))
                                    rNew.modelName = rGenerated1.worldMapShip;

                                if(CheckAttribute(rGenerated1, "Nation"))
                                {
                                    iNation = sti(rGenerated1.Nation);

                                    if(GetNationRelation2MainCharacter(iNation) == RELATION_ENEMY)
                                        rNew.isEnemy = true;
                                    else
                                        rNew.isEnemy = false;
                                }

                                rNew.sec = MakeInt(GetSecond());
                                rNew.min = MakeInt(GetMinute());
                                rNew.hour = MakeInt(GetHour());
                                rNew.day = GetDataDay();
                                rNew.month = GetDataMonth();
                                rNew.year = GetDataYear();

                                iTimeoutDays = 5 + rand(5);
                                fLifetime = (24.0 / fHourPerSec) * makefloat(iTimeoutDays);
                                rNew.livetime = fLifetime;

                                WdmCopyEncounterData(rGenerated1, sNewID1);

                                trace("DS REPLENISH CREATED: Follow id=" + sNewID1 +
                                      " shell=" + sShellMode +
                                      " shellType=" + sFollowShellType +
                                      " model=" + rNew.modelName +
                                      " pos=" + rNew.x + "," + rNew.z +
                                      " lifeDays=" + iTimeoutDays);

                                bCreated = true;
                            }
                        }
                        else
                        {
                            trace("DS REPLENISH: Follow generation attempt failed.");
                        }

                        ReleaseMapEncounters();
                    }
                    else
                    {
                        trace("DS REPLENISH: Follow roll triggered but follow encounters are stopped.");
                    }
                }
            }

            // =============================================================
            // SPECIAL - independent test after Warring/Follow, like CLAOP.
            // =============================================================
            iRollSpecial = rand(1001) + 1;

            if(iRollSpecial < wdmTimeOfLastSpecial)
            {
                wdmTimeOfLastSpecial = 0.0;

                iEncounter1 = -1;
                iEncounter2 = -1;

                if(GenerateMapEncounter(WDM_ETYPE_SPECIAL, worldMap.island, &iEncounter1, &iEncounter2))
                {
                    rGenerated1 = GetMapEncounterRef(iEncounter1);

                    iPersistentIndex = -1;
                    for(j = 0; j < 1000; j++)
                    {
                        sNewID1 = "enc_" + j;
                        sPath = "encounters." + sNewID1;

                        if(!CheckAttribute(&worldMap, sPath))
                        {
                            iPersistentIndex = j;
                            break;
                        }
                    }

                    if(iPersistentIndex >= 0)
                    {
                        sNewID1 = "enc_" + iPersistentIndex;
                        sPath = "encounters." + sNewID1;

                        fAngle = frnd() * PIm2;
                        fSpawnRadius = fMinSpawnRadius + makefloat(rand(100));
                        fX = fPlayerMapX + fSpawnRadius * sin(fAngle);
                        fZ = fPlayerMapZ + fSpawnRadius * cos(fAngle);

                        worldMap.(sPath) = "";
                        makearef(rNew, worldMap.(sPath));
                        if(sSourceID != "")
                        {
                            makearef(rShellSource, worldMap.encounters.(sSourceID));
                            CopyAttributes(rNew, rShellSource);

                            DeleteAttribute(rNew, "needDelete");
                            DeleteAttribute(rNew, "dirSailEnc");
                            DeleteAttribute(rNew, "quest");
                            DeleteAttribute(rNew, "encdata");
                            DeleteAttribute(rNew, "attacked");
                        }
                        else
                        {
                            // Fallback: construct the native physical encounter shell
                            // directly when no ordinary Merchant template exists.
                            rNew.brnAlpha = 1;
                            rNew.deleteAlpha = 1;

                            rNew.y = 0.0;
                            rNew.ax = frnd() * PIm2;
                            rNew.ay = frnd() * PIm2;
                            rNew.az = frnd() * PIm2;
                            rNew.dltAx = 0.8;
                            rNew.dltAz = 1.2;

                            rNew.speed = 0.0;
                            rNew.turnspd = 0.0;
                            rNew.kMaxSpeed = 1.0;
                            rNew.rspeed_x = 0.0;
                            rNew.rspeed_y = 0.0;
                            rNew.rspeed_z = 0.0;
                            rNew.slope = 0.0;

                            rNew.enc_id = 2147483647;
                            rNew.isEnableKill = 1;
                            rNew.isEnemy = 0;
                            rNew.killme = 0;
                            rNew.canSkip = 0;

                            rNew.gotox = fX + 50.0 * sin(fAngle);
                            rNew.gotoz = fZ + 50.0 * cos(fAngle);
                            rNew.gotoRad = 2.0;
                            rNew.isEnableSetDir = 0;
                        }

                        rNew.dsGenerated = true;
                        rNew.dsGeneratedKind = "Special";
                        rNew.dsGeneratedSpecial = true;
                        rNew.type = "Merchant";
                        rNew.x = fX;
                        rNew.z = fZ;

                        if(CheckAttribute(rGenerated1, "worldMapShip"))
                            rNew.modelName = rGenerated1.worldMapShip;

                        if(CheckAttribute(rGenerated1, "Nation"))
                        {
                            iNation = sti(rGenerated1.Nation);

                            if(GetNationRelation2MainCharacter(iNation) == RELATION_ENEMY)
                                rNew.isEnemy = true;
                            else
                                rNew.isEnemy = false;
                        }

                        rNew.sec = MakeInt(GetSecond());
                        rNew.min = MakeInt(GetMinute());
                        rNew.hour = MakeInt(GetHour());
                        rNew.day = GetDataDay();
                        rNew.month = GetDataMonth();
                        rNew.year = GetDataYear();

                        iTimeoutDays = 5 + rand(5);
                        fLifetime = (24.0 / fHourPerSec) * makefloat(iTimeoutDays);
                        rNew.livetime = fLifetime;

                        WdmCopyEncounterData(rGenerated1, sNewID1);

                        trace("DS REPLENISH CREATED: Special id=" + sNewID1 +
                              " shell=" + sShellMode +
                              " model=" + rNew.modelName +
                              " pos=" + rNew.x + "," + rNew.z +
                              " lifeDays=" + iTimeoutDays);

                        bCreated = true;
                    }
                }
                else
                {
                    trace("DS REPLENISH: Special generation attempt failed.");
                }

                ReleaseMapEncounters();
            }
        }
    }

    if(bCreated)
    {
        makearef(WME, worldMap.encounters);
        trace("DS REPLENISH: persistent pool now=" + GetAttributesNum(WME));
    }

    // Storms remain a separate sibling system for later integration.
}


