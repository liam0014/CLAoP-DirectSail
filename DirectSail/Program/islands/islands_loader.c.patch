// Apply a small share of CLAOP's normal daily repair once per Direct Sail
// game hour. The repair transaction itself mirrors ProcessDayRepair(): it
// repairs all player/companion ships, consumes the normal materials, and
// awards the normal Repair-skill experience.
//
// bDisableMapEnter is also used by the sea time-scale restrictions, so no
// passive Direct Sail repair is allowed while an active engagement is close
// enough to impose the game's combat restriction.
void DirectSail_ProcessHourlyRepair()
{
    int i;
    int cn;
    float matQ;
    float tmpf;
    float repPercent;
    ref chref;

    if(bDisableMapEnter) return;

    for(i = 0; i < COMPANION_MAX; i++)
    {
        cn = GetCompanionIndex(pchar, i);
        if(cn == -1) continue;

        chref = GetCharacter(cn);

        if(GetHullPercent(chref) < 100.0)
        {
            repPercent = GetHullRPD(chref) / DS_HOURLY_REPAIR_DIVISOR;
            matQ = repPercent * GetHullPPP(chref);
            tmpf = GetRepairGoods(true, chref);

            if(tmpf > 0)
            {
                if(tmpf < matQ) repPercent = tmpf / GetHullPPP(chref);
                repPercent = ProcessHullRepair(chref, repPercent);
                matQ = repPercent * GetHullPPP(chref);
                RemoveRepairGoods(true, chref, matQ);
                AddCharacterExpToSkill(chref, "Repair", matQ / 3.0);
            }
        }

        if(GetSailPercent(chref) < 100.0)
        {
            repPercent = GetSailRPD(chref) / DS_HOURLY_REPAIR_DIVISOR;
            matQ = repPercent * GetSailSPP(chref);
            tmpf = GetRepairGoods(false, chref);

            if(tmpf > 0)
            {
                if(tmpf < matQ) repPercent = tmpf / GetSailSPP(chref);
                repPercent = ProcessSailRepair(chref, repPercent);
                matQ = repPercent * GetSailSPP(chref);
                RemoveRepairGoods(false, chref, matQ);
                AddCharacterExpToSkill(chref, "Repair", matQ / 4.0);
            }
        }
    }
}

void DirectSail_CleanupGeneratedEncounters()
{
    aref WME;
    aref rEnc;

    int i;
    int iCount;
    int iRemoved;
    int iExpired;
    int iConsumed;
    int iAgeHours;

    string sID;
    string sPath;
    string sReason;

    makearef(WME, worldMap.encounters);

    iCount = GetAttributesNum(WME);
    iRemoved = 0;
    iExpired = 0;
    iConsumed = 0;

    for(i = iCount - 1; i >= 0; i--)
    {
        rEnc = GetAttributeN(WME, i);

        if(!CheckAttribute(rEnc, "dsGenerated")) continue;
        if(CheckAttribute(rEnc, "quest")) continue;

        sID = GetAttributeName(rEnc);
        sPath = "encounters." + sID;
        sReason = "";

        if(CheckAttribute(rEnc, "needDelete"))
        {
            sReason = "consumed";
            iConsumed++;
        }
        else
        {
            if(CheckAttribute(rEnc, "year") &&
               CheckAttribute(rEnc, "month") &&
               CheckAttribute(rEnc, "day") &&
               CheckAttribute(rEnc, "hour"))
            {
                iAgeHours = GetPastTime(
                    "hour",
                    sti(rEnc.year),
                    sti(rEnc.month),
                    sti(rEnc.day),
                    stf(rEnc.hour),
                    GetDataYear(),
                    GetDataMonth(),
                    GetDataDay(),
                    GetTime()
                );

                if(iAgeHours > 24)
                {
                    sReason = "expired";
                    iExpired++;
                }
            }
        }

        if(sReason != "")
        {
            trace("DS CLEANUP: delete id=" + sID +
                  " type=" + rEnc.type +
                  " reason=" + sReason);

            DeleteAttribute(&worldMap, sPath);
            iRemoved++;
        }
    }

    if(iRemoved > 0)
    {
        makearef(WME, worldMap.encounters);

        trace("DS CLEANUP: removed=" + iRemoved +
              " consumed=" + iConsumed +
              " expired=" + iExpired +
              " poolNow=" + GetAttributesNum(WME));
    }
}


void DirectSail_RefreshStormWeatherAfterTransition(float fPlayerMapX, float fPlayerMapZ)
{
    int i;
    int iNum;
    float fStormX;
    float fStormZ;
    float fDist;
    float fBestDist;
    bool bFound;
    bool bFoundTornado;
    string sBestID;
    string sBestPath;
    aref WME;
    aref rStorm;
    aref rBestStorm;

    bFound = false;
    bFoundTornado = false;
    sBestID = "";
    sBestPath = "";
    fBestDist = 999999999.0;

    makearef(WME, worldMap.encounters);
    iNum = GetAttributesNum(WME);

    for(i = 0; i < iNum; i++)
    {
        rStorm = GetAttributeN(WME, i);

        if(!CheckAttribute(rStorm, "type")) continue;
        if(rStorm.type != "Storm") continue;
        if(CheckAttribute(rStorm, "needDelete")) continue;
        if(!CheckAttribute(rStorm, "px")) continue;
        if(!CheckAttribute(rStorm, "pz")) continue;

        fStormX = stf(rStorm.px);
        fStormZ = stf(rStorm.pz);

        // Storm proximity belongs to persistent world-map space, not the
        // current sea-map scale. Convert the squared map distance to the
        // canonical scale-50 sea equivalent so the original CLAOP thresholds
        // remain unchanged everywhere.
        fDist = GetDistance2DRel(fPlayerMapX, fPlayerMapZ, fStormX, fStormZ);
        fDist = fDist * WDM_MAP_TO_SEA_SCALE * WDM_MAP_TO_SEA_SCALE;

        if(fDist > DIR_SAIL_STORMWARN_DIST_REL) continue;
        if(bFound && fDist >= fBestDist) continue;

        bFound = true;
        fBestDist = fDist;
        sBestID = GetAttributeName(rStorm);
        sBestPath = "encounters." + sBestID;

        bFoundTornado = false;
        if(CheckAttribute(rStorm, "isTornado") && sti(rStorm.isTornado) != 0)
        {
            bFoundTornado = true;
        }
    }

    if(!bFound) return;
    if(sBestID == "") return;

    makearef(rBestStorm, worldMap.(sBestPath));


    if(fBestDist <= DIR_SAIL_STORM_DIST_REL)
    {
        rBestStorm.needDelete = "Reload delete storm encounter";

        bStorm = true;
        bTornado = bFoundTornado;
        WeatherParams.Tornado = bFoundTornado;
        WeatherParams.Storm = true;
        iStormLockSeconds = 60 + rand(120);
        Seafoam.storm = "true";
        Whr_UpdateWeather();
        SetSchemeForSea();

    }
    else
    {
        WeatherParams.Rain.ThisDay = true;
        WeatherParams.Rain.StartTime = MakeInt(GetHour());
        WeatherParams.Rain.Duration = 75.0;
        Whr_UpdateWeather();
        Log_SetStringToLog(StringFromKey("InfoMessages_89"));

    }
}


void DirectSail_UpdatePersistentStorms()
{
    int i;
    int iNum;
    float fOldX;
    float fOldZ;
    float fNewX;
    float fNewZ;
    float fOldLife;
    float fNewLife;
    float fStep;
    string sID;
    string sPath;
    aref WME;
    aref rStorm;

    makearef(WME, worldMap.encounters);
    iNum = GetAttributesNum(WME);

    // Advance every persistent storm while the world-map entity is inactive.
    // This keeps native world-map storms and Direct Sail-generated storms in
    // one shared world state.
    for(i = iNum - 1; i >= 0; i--)
    {
        rStorm = GetAttributeN(WME, i);

        if(!CheckAttribute(rStorm, "type")) continue;
        if(rStorm.type != "Storm") continue;

        sID = GetAttributeName(rStorm);
        sPath = "encounters." + sID;

        // Storms consumed by Direct Sail leave the persistent pool immediately.
        if(CheckAttribute(rStorm, "needDelete"))
        {
            trace("DS STORM REMOVE: id=" + sID +
                  " reason=" + rStorm.needDelete);
            DeleteAttribute(&worldMap, sPath);
            continue;
        }

        // Skip malformed storm shells rather than risking a script error.
        if(!CheckAttribute(rStorm, "px")) continue;
        if(!CheckAttribute(rStorm, "pz")) continue;
        if(!CheckAttribute(rStorm, "dx")) continue;
        if(!CheckAttribute(rStorm, "dz")) continue;
        if(!CheckAttribute(rStorm, "speed")) continue;
        if(!CheckAttribute(rStorm, "livetime")) continue;

        fOldX = stf(rStorm.px);
        fOldZ = stf(rStorm.pz);
        fOldLife = stf(rStorm.livetime);

        fStep = stf(rStorm.speed) * DS_REPLENISH_MAP_SECONDS_PER_HOUR;

        fNewX = fOldX + stf(rStorm.dx) * fStep;
        fNewZ = fOldZ + stf(rStorm.dz) * fStep;
        fNewLife = fOldLife - DS_REPLENISH_MAP_SECONDS_PER_HOUR;

        rStorm.px = fNewX;
        rStorm.pz = fNewZ;
        rStorm.livetime = fNewLife;

        if(fNewLife <= 0.0)
        {
            trace("DS STORM EXPIRE: id=" + sID +
                  " finalPos=" + fNewX + "," + fNewZ);
            DeleteAttribute(&worldMap, sPath);
        }
    }
}


int DirectSail_CountPersistentStorms()
{
    int i;
    int iNum;
    int iCount = 0;
    aref WME;
    aref rStorm;

    makearef(WME, worldMap.encounters);
    iNum = GetAttributesNum(WME);

    for(i = 0; i < iNum; i++)
    {
        rStorm = GetAttributeN(WME, i);

        if(!CheckAttribute(rStorm, "type")) continue;
        if(rStorm.type != "Storm") continue;
        if(CheckAttribute(rStorm, "needDelete")) continue;

        iCount++;
    }

    return iCount;
}


bool DirectSail_CreateGeneratedStorm(float fPlayerMapX, float fPlayerMapZ)
{
    int i;
    int iPersistentIndex;
    int iAngleDeg;
    int iRadius;
    int iSpeedRoll;
    int iLifeRoll;
    int iTornadoRoll;
    int iTornado;
    float fAngle;
    float fDirAngle;
    float fX;
    float fZ;
    float fDirX;
    float fDirZ;
    float fSpeed;
    float fLife;
    string sID;
    string sPath;
    aref rStorm;

    // Find the first unused persistent encounter identifier.
    iPersistentIndex = -1;
    for(i = 0; i < 1000; i++)
    {
        sID = "enc_" + i;
        sPath = "encounters." + sID;

        if(!CheckAttribute(&worldMap, sPath))
        {
            iPersistentIndex = i;
            break;
        }
    }

    if(iPersistentIndex < 0)
    {
        trace("DS STORM CREATE FAILED: no free persistent encounter ID");
        return false;
    }

    sID = "enc_" + iPersistentIndex;
    sPath = "encounters." + sID;

    // CLAOP's native world-map storm birth distance is 100-140 map units.
    iAngleDeg = rand(359);
    fAngle = makefloat(iAngleDeg) * 0.0174532925;
    iRadius = 100 + rand(40);

    fX = fPlayerMapX + makefloat(iRadius) * sin(fAngle);
    fZ = fPlayerMapZ + makefloat(iRadius) * cos(fAngle);

    // Independent random movement direction.
    iAngleDeg = rand(359);
    fDirAngle = makefloat(iAngleDeg) * 0.0174532925;
    fDirX = sin(fDirAngle);
    fDirZ = cos(fDirAngle);

    // Use the native-style storm speed range observed in CLAOP.
    iSpeedRoll = rand(15);
    fSpeed = 5.5 + makefloat(iSpeedRoll) / 10.0;

    // Give Direct Sail-created storms a native-style 90-120 simulation-second lifetime.
    iLifeRoll = rand(30);
    fLife = 90.0 + makefloat(iLifeRoll);

    worldMap.(sPath) = "";
    makearef(rStorm, worldMap.(sPath));

    rStorm.type = "Storm";

    rStorm.px = fX;
    rStorm.py = 30.0;
    rStorm.pz = fZ;

    rStorm.dx = fDirX;
    rStorm.dy = 0.0;
    rStorm.dz = fDirZ;

    rStorm.isActiveTime = 0.0;
    rStorm.livetime = fLife;
    rStorm.liveAlpha = 1.0;
    rStorm.speed = fSpeed;
    rStorm.isBrn = 0;
    rStorm.isKl = 0;

    // CLAOP's native wdmCreateStorm() contains an apparent leftover test
    // override which forces every generated storm to be a tornado. The random
    // logic immediately before that override gives roughly a 45% chance.
    // Direct Sail uses that intended-looking random behaviour instead.
    iTornadoRoll = rand(1000);
    iTornado = 0;
    if(iTornadoRoll != 0 && iTornadoRoll < 450)
    {
        iTornado = 1;
    }
    rStorm.isTornado = iTornado;

    rStorm.num = 6;

    // Six-cloud shell accepted by the native world-map storm renderer.
    rStorm.cloudPos0x = 20.0;
    rStorm.cloudPos0y = 0.0;
    rStorm.cloudPos0z = -20.0;
    rStorm.rotSpd0 = -0.10;

    rStorm.cloudPos1x = -20.0;
    rStorm.cloudPos1y = 0.5;
    rStorm.cloudPos1z = -15.0;
    rStorm.rotSpd1 = -0.08;

    rStorm.cloudPos2x = 35.0;
    rStorm.cloudPos2y = 1.0;
    rStorm.cloudPos2z = 5.0;
    rStorm.rotSpd2 = -0.05;

    rStorm.cloudPos3x = 15.0;
    rStorm.cloudPos3y = -0.5;
    rStorm.cloudPos3z = 25.0;
    rStorm.rotSpd3 = -0.12;

    rStorm.cloudPos4x = -35.0;
    rStorm.cloudPos4y = 0.5;
    rStorm.cloudPos4z = 10.0;
    rStorm.rotSpd4 = -0.04;

    rStorm.cloudPos5x = 0.0;
    rStorm.cloudPos5y = 1.0;
    rStorm.cloudPos5z = -30.0;
    rStorm.rotSpd5 = -0.09;

    rStorm.sec = MakeInt(GetSecond());
    rStorm.min = MakeInt(GetMinute());
    rStorm.hour = MakeInt(GetHour());
    rStorm.day = GetDataDay();
    rStorm.month = GetDataMonth();
    rStorm.year = GetDataYear();

    trace("DS STORM CREATED: id=" + sID +
          " player=" + fPlayerMapX + "," + fPlayerMapZ +
          " storm=" + fX + "," + fZ +
          " radius=" + iRadius +
          " speed=" + fSpeed +
          " life=" + fLife +
          " tornado=" + iTornado);

    return true;
}


void DirectSail_ProcessNaturalStormGeneration(float fPlayerMapX, float fPlayerMapZ)
{
    int iStorms;
    float fAccumulator;
    float fIncrement;
    int iRoll;

    // Match CLAOP's native rule: do not accumulate another storm while a live
    // persistent storm already exists.
    iStorms = DirectSail_CountPersistentStorms();
    if(iStorms > 0)
    {
        pchar.DirectSail.StormAccumulator = 0.0;
        trace("DS STORM CHECK: existing=" + iStorms +
              " accumulator reset");
        return;
    }

    fAccumulator = 0.0;
    if(CheckAttribute(pchar, "DirectSail.StormAccumulator"))
    {
        fAccumulator = stf(pchar.DirectSail.StormAccumulator);
    }

    // CLAOP native storm-generation formula per world-map simulation second:
    // dltTime * 0.0001 * 1000 * iEncountersRate
    fIncrement = DS_REPLENISH_MAP_SECONDS_PER_HOUR * 0.0009 * 1000.0 * makefloat(iEncountersRate);
    fAccumulator = fAccumulator + fIncrement;
    pchar.DirectSail.StormAccumulator = fAccumulator;

    iRoll = rand(1001);

    trace("DS STORM ROLL: accumulator=" + fAccumulator +
          " increment=" + fIncrement +
          " roll=" + iRoll +
          " encounterRate=" + iEncountersRate);

    if(makefloat(iRoll) < fAccumulator)
    {
        if(DirectSail_CreateGeneratedStorm(fPlayerMapX, fPlayerMapZ))
        {
            pchar.DirectSail.StormAccumulator = 0.0;
        }
    }
}


void DirectSail_ReplenishEncounters(float fPlayerMapX, float fPlayerMapZ, int iScale)
{
    aref WME;
    aref rRawGroup;
    aref rShellSource;
    aref rNew;

    ref rGenerated1;
    ref rGenerated2;

    int i;
    int j;
    int iCount;
    int iLocalCount;
    int iGlobalCount;
    int iEncounter1;
    int iEncounter2;
    int iPersistentIndex;
    int iNation;
    int iTimeoutDays;

    float fDx;
    float fDz;
    float fDistSq;
    float fAngle;
    float fSpawnRadius;
    float fMinSpawnRadius;
    float fHourPerSec;
    float fLifetime;
    float fX;
    float fZ;
    float fPairGap;
    float fTick;

    int iRollMerchant;
    int iRollWarring;
    int iRollFollow;
    int iRollSpecial;

    bool bEncOff;
    bool bCreated;

    string sSourceID;
    string sPath;
    string sNewID1;
    string sNewID2;
    string sFollowShellType;
    string sShellMode;

    // Move/age the shared persistent storm population, then apply CLAOP-style
    // storm generation if no live persistent storm exists.
    DirectSail_UpdatePersistentStorms();
    DirectSail_ProcessNaturalStormGeneration(fPlayerMapX, fPlayerMapZ);

    // Remove Direct Sail-created ship/special encounters that were consumed
    // or have expired.
    DirectSail_CleanupGeneratedEncounters();

    makearef(WME, worldMap.encounters);

    iCount = GetAttributesNum(WME);
    iLocalCount = 0;
    iGlobalCount = 0;
    sSourceID = "";

    // Count usable persistent random encounters near the CURRENT Direct Sail
    // position and find an ordinary Merchant shell to use as native template.
    for(i = 0; i < iCount; i++)
    {
        rRawGroup = GetAttributeN(WME, i);

        if(!CheckAttribute(rRawGroup, "type")) continue;
        if(rRawGroup.type == "Storm") continue;
        if(CheckAttribute(rRawGroup, "needDelete")) continue;
        if(CheckAttribute(rRawGroup, "dirSailEnc")) continue;

        // Random Specials now participate in the same local persistent
        // encounter population as Merchant / Follow / Warring encounters.
        if(CheckAttribute(rRawGroup, "quest")) continue;
        if(!CheckAttribute(rRawGroup, "encdata")) continue;

        iGlobalCount++;

        if(CheckAttribute(rRawGroup, "x") && CheckAttribute(rRawGroup, "z"))
        {
            fDx = stf(rRawGroup.x) - fPlayerMapX;
            fDz = stf(rRawGroup.z) - fPlayerMapZ;
            fDistSq = (fDx * fDx) + (fDz * fDz);

            if(fDistSq <= DS_REPLENISH_LOCAL_RADIUS_SQ)
            {
                iLocalCount++;
            }
        }

        if(sSourceID == "" && rRawGroup.type == "Merchant")
        {
            // Special encounters also use a Merchant native shell; do not use
            // one of those as the ordinary template.
            if(CheckAttribute(rRawGroup, "encdata.Type"))
            {
                if(rRawGroup.encdata.Type == "special") continue;
            }

            sSourceID = GetAttributeName(rRawGroup);
        }
    }

    trace("DS REPLENISH: local=" + iLocalCount +
          " global=" + iGlobalCount +
          " island=" + worldMap.island +
          " pos=" + fPlayerMapX + "," + fPlayerMapZ);

    // Base CLAOP resets its generation timers while the encounter population
    // is full. Direct Sail applies that ceiling LOCALLY around the player's
    // current world-map-equivalent position.
    if(iLocalCount >= DS_REPLENISH_LOCAL_TARGET)
    {
        wdmTimeOfLastMerchant = 0.0;
        wdmTimeOfLastWarring = 0.0;
        wdmTimeOfLastFollow = 0.0;
        wdmTimeOfLastSpecial = 0.0;
        return;
    }

    // Prefer an existing ordinary Merchant shell when available.
    // If none exists, construct the proven synthetic physical shell instead.
    sShellMode = "clone";

    if(sSourceID == "")
    {
        sShellMode = "synthetic";
    }

    fTick = DS_REPLENISH_MAP_SECONDS_PER_HOUR;

    // Same accumulator maths as CLAOP's normal wdmShipEncounter().
    wdmTimeOfLastMerchant = wdmTimeOfLastMerchant + fTick * DS_REPLENISH_MERCHANT_RATE * 1000.0 * iEncountersRate;
    wdmTimeOfLastWarring = wdmTimeOfLastWarring + fTick * DS_REPLENISH_WARRING_RATE * 1000.0 * iEncountersRate;
    wdmTimeOfLastFollow = wdmTimeOfLastFollow + fTick * DS_REPLENISH_FOLLOW_RATE * 1000.0 * iEncountersRate;
    wdmTimeOfLastSpecial = wdmTimeOfLastSpecial + fTick * DS_REPLENISH_SPECIAL_RATE * 1000.0 * iEncountersRate;

    trace("DS REPLENISH: timers M=" + wdmTimeOfLastMerchant +
          " W=" + wdmTimeOfLastWarring +
          " F=" + wdmTimeOfLastFollow +
          " S=" + wdmTimeOfLastSpecial);


    bEncOff = false;
    if(CheckAttribute(pchar, "worldmapencountersoff") == 1)
    {
        bEncOff = sti(pchar.worldmapencountersoff);
    }

    bCreated = false;

    // New encounters appear outside the immediate Direct Sail encounter radius
    // but still inside the local-population radius.
    fMinSpawnRadius = (2500.0 / makefloat(iScale)) + 30.0;
    fPairGap = 5.0;

    fHourPerSec = 1.0;
    if(CheckAttribute(&worldMap, "date.hourPerSec"))
    {
        fHourPerSec = stf(worldMap.date.hourPerSec);
        if(fHourPerSec <= 0.0) fHourPerSec = 1.0;
    }

    // =====================================================================
    // MERCHANT
    // =====================================================================
    iRollMerchant = rand(1001) + 1;

    if(iRollMerchant < wdmTimeOfLastMerchant)
    {
        wdmTimeOfLastMerchant = 0.0;

        iEncounter1 = -1;
        iEncounter2 = -1;

        if(GenerateMapEncounter(WDM_ETYPE_MERCHANT, worldMap.island, &iEncounter1, &iEncounter2))
        {
            rGenerated1 = GetMapEncounterRef(iEncounter1);

            iPersistentIndex = -1;
            for(j = 0; j < 1000; j++)
            {
                sNewID1 = "enc_" + j;
                sPath = "encounters." + sNewID1;

                if(!CheckAttribute(&worldMap, sPath))
                {
                    iPersistentIndex = j;
                    break;
                }
            }

            if(iPersistentIndex >= 0)
            {
                sNewID1 = "enc_" + iPersistentIndex;
                sPath = "encounters." + sNewID1;

                fAngle = frnd() * PIm2;
                fSpawnRadius = fMinSpawnRadius + makefloat(rand(100));
                fX = fPlayerMapX + fSpawnRadius * sin(fAngle);
                fZ = fPlayerMapZ + fSpawnRadius * cos(fAngle);

                worldMap.(sPath) = "";
                makearef(rNew, worldMap.(sPath));
                if(sSourceID != "")
                {
                    makearef(rShellSource, worldMap.encounters.(sSourceID));
                    CopyAttributes(rNew, rShellSource);

                    DeleteAttribute(rNew, "needDelete");
                    DeleteAttribute(rNew, "dirSailEnc");
                    DeleteAttribute(rNew, "quest");
                    DeleteAttribute(rNew, "encdata");
                    DeleteAttribute(rNew, "attacked");
                }
                else
                {
                    // Fallback: construct the native physical encounter shell
                    // directly when no ordinary Merchant template exists.
                    rNew.brnAlpha = 1;
                    rNew.deleteAlpha = 1;

                    rNew.y = 0.0;
                    rNew.ax = frnd() * PIm2;
                    rNew.ay = frnd() * PIm2;
                    rNew.az = frnd() * PIm2;
                    rNew.dltAx = 0.8;
                    rNew.dltAz = 1.2;

                    rNew.speed = 0.0;
                    rNew.turnspd = 0.0;
                    rNew.kMaxSpeed = 1.0;
                    rNew.rspeed_x = 0.0;
                    rNew.rspeed_y = 0.0;
                    rNew.rspeed_z = 0.0;
                    rNew.slope = 0.0;

                    rNew.enc_id = 2147483647;
                    rNew.isEnableKill = 1;
                    rNew.isEnemy = 0;
                    rNew.killme = 0;
                    rNew.canSkip = 0;

                    rNew.gotox = fX + 50.0 * sin(fAngle);
                    rNew.gotoz = fZ + 50.0 * cos(fAngle);
                    rNew.gotoRad = 2.0;
                    rNew.isEnableSetDir = 0;
                }

                rNew.dsGenerated = true;
                rNew.dsGeneratedKind = "Merchant";
                rNew.type = "Merchant";
                rNew.x = fX;
                rNew.z = fZ;

                if(CheckAttribute(rGenerated1, "worldMapShip"))
                    rNew.modelName = rGenerated1.worldMapShip;

                if(CheckAttribute(rGenerated1, "Nation"))
                {
                    iNation = sti(rGenerated1.Nation);

                    if(GetNationRelation2MainCharacter(iNation) == RELATION_ENEMY)
                        rNew.isEnemy = true;
                    else
                        rNew.isEnemy = false;
                }

                rNew.sec = MakeInt(GetSecond());
                rNew.min = MakeInt(GetMinute());
                rNew.hour = MakeInt(GetHour());
                rNew.day = GetDataDay();
                rNew.month = GetDataMonth();
                rNew.year = GetDataYear();

                iTimeoutDays = 5 + rand(5);
                fLifetime = (24.0 / fHourPerSec) * makefloat(iTimeoutDays);
                rNew.livetime = fLifetime;

                WdmCopyEncounterData(rGenerated1, sNewID1);

                trace("DS REPLENISH CREATED: Merchant id=" + sNewID1 +
                      " shell=" + sShellMode +
                      " model=" + rNew.modelName +
                      " pos=" + rNew.x + "," + rNew.z +
                      " lifeDays=" + iTimeoutDays);

                bCreated = true;
            }
        }
        else
        {
            trace("DS REPLENISH: Merchant generation attempt failed.");
        }

        ReleaseMapEncounters();
    }
    else
    {
        // =============================================================
        // WARRING / FOLLOW
        // =============================================================
        if(!bEncOff)
        {
            iRollWarring = rand(1001) + 1;

            if(iRollWarring < wdmTimeOfLastWarring)
            {
                wdmTimeOfLastWarring = 0.0;

                iEncounter1 = -1;
                iEncounter2 = -1;

                if(GenerateMapEncounter(WDM_ETYPE_WARRING, worldMap.island, &iEncounter1, &iEncounter2))
                {
                    if(iEncounter1 >= 0 && iEncounter2 >= 0)
                    {
                        rGenerated1 = GetMapEncounterRef(iEncounter1);
                        rGenerated2 = GetMapEncounterRef(iEncounter2);

                        sNewID1 = "";
                        sNewID2 = "";

                        iPersistentIndex = -1;
                        for(j = 0; j < 1000; j++)
                        {
                            sNewID1 = "enc_" + j;
                            sPath = "encounters." + sNewID1;

                            if(!CheckAttribute(&worldMap, sPath))
                            {
                                iPersistentIndex = j;
                                break;
                            }
                        }

                        if(iPersistentIndex >= 0)
                        {
                            sNewID1 = "enc_" + iPersistentIndex;

                            fAngle = frnd() * PIm2;
                            fSpawnRadius = fMinSpawnRadius + makefloat(rand(100));
                            fX = fPlayerMapX + fSpawnRadius * sin(fAngle);
                            fZ = fPlayerMapZ + fSpawnRadius * cos(fAngle);

                            // WARRING
                            sPath = "encounters." + sNewID1;
                            worldMap.(sPath) = "";
                            makearef(rNew, worldMap.(sPath));
                            if(sSourceID != "")
                            {
                                makearef(rShellSource, worldMap.encounters.(sSourceID));
                                CopyAttributes(rNew, rShellSource);

                                DeleteAttribute(rNew, "needDelete");
                                DeleteAttribute(rNew, "dirSailEnc");
